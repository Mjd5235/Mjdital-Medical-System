generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  ACCOUNTANT

  @@map("user_role")
}

enum IdentityType {
  NATIONAL_ID
  IQAMA

  @@map("identity_type")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum DoctorPresence {
  AVAILABLE
  BUSY
  ON_BREAK
  OFF_DUTY

  @@map("doctor_presence")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum AuditActionType {
  READ
  CREATE
  UPDATE
  DELETE

  @@map("audit_action_type")
}

/// Tenant root. Isolation key for all other tables is clinic_id.
model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  crNumber  String?  @map("cr_number")
  vatNumber String?  @map("vat_number")
  city      String   @default("Riyadh")
  region    String   @default("SA-01")
  timezone  String   @default("Asia/Riyadh")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  specialty  String? @map("specialty")
  nphiesCode String? @map("nphies_code")

  users              User[]
  doctors            Doctor[]
  patients           Patient[]
  appointments       Appointment[]
  auditLogs          AuditLog[]
  invoices           Invoice[]
  insuranceProviders InsuranceProvider[]
  services           Service[]

  @@map("clinics")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  code        String
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  vatRate     Decimal  @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("services")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  email        String
  passwordHash String    @map("password_hash")
  fullNameAr   String    @map("full_name_ar")
  fullNameEn   String    @map("full_name_en")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor       Doctor?
  auditLogs    AuditLog[]
  appointments Appointment[] @relation("AppointmentCreatedBy")

  @@unique([clinicId, email])
  @@index([clinicId])
  @@index([clinicId, role])
  @@map("users")
}

model Doctor {
  id                  String         @id @default(uuid()) @db.Uuid
  clinicId            String         @map("clinic_id") @db.Uuid
  userId              String?        @unique @map("user_id") @db.Uuid
  fullNameAr          String         @map("full_name_ar")
  fullNameEn          String         @map("full_name_en")
  specialtyAr         String         @map("specialty_ar")
  specialtyEn         String         @map("specialty_en")
  scfhsLicenseNumber  String         @map("scfhs_license_number")
  presence            DoctorPresence @default(AVAILABLE)
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([clinicId, scfhsLicenseNumber])
  @@index([clinicId])
  @@map("doctors")
}

model Patient {
  id                    String       @id @default(uuid()) @db.Uuid
  clinicId              String       @map("clinic_id") @db.Uuid
  fileNumber            String       @map("file_number")
  nationalId            String       @map("national_id") @db.Char(10)
  identityType          IdentityType @map("identity_type")
  fullNameAr            String       @map("full_name_ar")
  fullNameEn            String       @map("full_name_en")
  dateOfBirth           DateTime?    @map("date_of_birth") @db.Date
  gender                Gender?
  phone                 String?
  insuranceProviderId   String?      @map("insurance_provider_id") @db.Uuid
  insuranceMemberId     String?      @map("insurance_member_id")
  insuranceApprovalCode String?      @map("insurance_approval_code")
  copayPercentage       Decimal?     @map("copay_percentage") @db.Decimal(5, 2)
  copayFixedCap         Decimal?     @map("copay_fixed_cap") @db.Decimal(12, 2)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  insuranceProvider  InsuranceProvider?  @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  appointments       Appointment[]
  invoices           Invoice[]

  @@unique([clinicId, fileNumber])
  @@unique([clinicId, nationalId])
  @@index([clinicId])
  @@map("patients")
}

model Appointment {
  id               String             @id @default(uuid()) @db.Uuid
  clinicId         String             @map("clinic_id") @db.Uuid
  doctorId         String             @map("doctor_id") @db.Uuid
  patientId        String             @map("patient_id") @db.Uuid
  createdByUserId  String?            @map("created_by_user_id") @db.Uuid
  status           AppointmentStatus  @default(SCHEDULED)
  scheduledAt      DateTime           @map("scheduled_at")
  startedAt        DateTime?          @map("started_at")
  completedAt      DateTime?          @map("completed_at")
  signedAt         DateTime?          @map("signed_at")
  signedByUserId   String?            @map("signed_by_user_id") @db.Uuid
  chiefComplaint   String?            @map("chief_complaint")
  diagnosis        String?
  diagnosisIcd10Am String?            @map("diagnosis_icd10_am")
  procedureAchi    String?            @map("procedure_achi")
  sbsCode          String?            @map("sbs_code")
  prescriptions    String?
  isLocked         Boolean            @default(false) @map("is_locked")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([clinicId])
  @@index([clinicId, doctorId, scheduledAt])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("appointments")
}

/// Append-only. UPDATE/DELETE must be rejected at the service and Prisma layers.
model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  clinicId    String          @map("clinic_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  actionType  AuditActionType @map("action_type")
  targetTable String          @map("target_table")
  recordId    String          @map("record_id")
  ipAddress   String?         @map("ip_address")
  userAgent   String?         @map("user_agent")
  metadata    Json?
  timestamp   DateTime        @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, timestamp])
  @@index([clinicId, targetTable, recordId])
  @@map("audit_logs")
}

model InsuranceProvider {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patients Patient[]

  @@unique([clinicId, nameEn])
  @@index([clinicId])
  @@map("insurance_providers")
}

/// ZATCA Phase 2 structural hooks. Hash chaining is implemented in a later phase.
model Invoice {
  id                  String   @id @default(uuid()) @db.Uuid
  clinicId            String   @map("clinic_id") @db.Uuid
  patientId           String   @map("patient_id") @db.Uuid
  appointmentId       String?  @map("appointment_id") @db.Uuid
  invoiceUuid         String   @unique @map("invoice_uuid") @db.Uuid
  invoiceCounter      Int      @map("invoice_counter")
  previousInvoiceHash String?  @map("previous_invoice_hash")
  subTotal            Decimal  @map("sub_total") @db.Decimal(12, 2)
  vatRate             Decimal  @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount           Decimal  @map("vat_amount") @db.Decimal(12, 2)
  grandTotal          Decimal  @map("grand_total") @db.Decimal(12, 2)
  vatExempt           Boolean  @default(false) @map("vat_exempt")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([clinicId, invoiceCounter])
  @@index([clinicId])
  @@index([clinicId, patientId])
  @@map("invoices")
}
