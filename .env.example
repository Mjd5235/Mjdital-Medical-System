# PostgreSQL / Supabase (Saudi region recommended for PDPL data residency)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mjdital?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mjdital?schema=public"

# HMAC secret for signed session cookies (min 16 characters). Never expose to the client.
SESSION_SECRET="replace-with-a-long-random-string"

NEXT_PUBLIC_APP_NAME="Mjdital"

# Optional: hide demo login hints even in `next dev`
# ALLOW_DEMO_HINTS="false"

# Local seed (never run in production):
#   npm run db:seed
# To rotate demo passwords on existing seed users:
#   RESET_DEMO_PASSWORDS=true npm run db:seed
